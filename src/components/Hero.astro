---
import ResponsivePicture from "./Picture.astro";
import { contact, heroSlides } from "../data/site.ts";
---

<section class="hero slab grain" id="top" aria-labelledby="hero-heading" data-hero>
  <div class="hero__media" data-hero-media>
    {heroSlides.map((slide, index) => (
      <div
        class:list={["hero__slide", index === 0 && "is-active"]}
        id={`hero-panel-${slide.id}`}
        aria-hidden={index === 0 ? "false" : "true"}
        data-hero-slide
        data-index={index}
      >
        <ResponsivePicture
          src={slide.image}
          alt={slide.alt}
          widths={[640, 960, 1440, 1920]}
          sizes="100vw"
          eager={index === 0}
          class="hero__image"
        />
      </div>
    ))}
    <div class="hero__fallback" data-hero-fallback hidden>
      <p>First Touch Group — premium commercial cleaning across {contact.serviceArea}.</p>
    </div>
  </div>

  <div class="hero__content">
    <p class="eyebrow">Premium commercial cleaning & workplace services</p>
    <h1 id="hero-heading">Clean spaces. <em>Stronger first impressions.</em></h1>
    <p class="hero__copy">
      Reliable commercial cleaning for offices, boutique hotels, and managed properties across {contact.serviceArea}.
      Trained teams, clear checks, and dependable cover.
    </p>
    <div class="actions">
      <a class="button" href="#quote">Request a quote</a>
      <a class="button button--ghost" href="#services">Explore services</a>
    </div>
  </div>

</section>

<style>
  .hero {
    position: sticky;
    top: 0;
    z-index: 0;
    min-height: min(100svh, 62rem);
    color: var(--ivory);
    background: var(--navy-mid);
    isolation: isolate;
  }

  .hero__media,
  .hero__slide {
    position: absolute;
    inset: 0;
  }

  .hero__slide :global(picture),
  .hero__slide :global(img),
  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__slide {
    opacity: 0;
    transition: opacity 850ms var(--ease);
  }

  .hero__slide.is-active {
    opacity: 1;
  }

  .hero__slide.is-active :global(img) {
    animation: hero-drift 9s var(--ease) forwards;
  }

  @keyframes hero-drift {
    from {
      transform: scale(1.001);
    }
    to {
      transform: scale(1.06);
    }
  }

  .hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 18% 88%, rgb(11 24 40 / 0.62) 0%, transparent 55%),
      linear-gradient(180deg, rgb(11 24 40 / 0.16) 0%, rgb(11 24 40 / 0.18) 42%, rgb(11 24 40 / 0.78) 100%),
      linear-gradient(90deg, rgb(11 24 40 / 0.5), rgb(11 24 40 / 0.06) 68%);
  }

  .hero__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: end start;
    padding: var(--section-space) var(--gutter);
    background: var(--navy-mid);
  }

  .hero__fallback[hidden] {
    display: none;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: center;
    gap: 1.15rem;
    min-height: min(100svh, 62rem);
    padding: clamp(5rem, 13vh, 9rem) var(--gutter) 7rem;
    width: min(100%, var(--content));
    max-width: none;
    margin-inline: auto;
  }

  .hero__content > * {
    max-width: 64rem;
  }

  h1 {
    font-size: clamp(3.25rem, 6.1vw, 6.35rem);
    font-weight: 480;
    line-height: 0.98;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  h1 em {
    display: block;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--white);
    line-height: 1.02;
  }

  .hero__copy {
    max-width: 38rem;
    color: rgb(255 255 255 / 0.9);
    font-size: clamp(1rem, 1.5vw, 1.25rem);
  }

  .hero .button {
    background: var(--white);
    color: var(--navy);
  }

  .hero .button--ghost {
    background: transparent;
    border-color: rgb(255 255 255 / 0.65);
    color: var(--white);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide {
      transition: none;
    }

    .hero__slide.is-active :global(img) {
      animation: none;
    }

  }

  @media (max-width: 47.99rem) {
    .hero {
      min-height: 100svh;
    }

    .hero__content {
      align-content: end;
      min-height: 100svh;
      max-width: none;
      padding-block: 5rem 8.5rem;
    }

    h1 {
      font-size: clamp(3rem, 14vw, 4.8rem);
    }

  }
</style>

<script>
  import "../scripts/hero.ts";
</script>
