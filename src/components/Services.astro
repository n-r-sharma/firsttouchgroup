---
import ResponsivePicture from "./Picture.astro";
import { services } from "../data/site.ts";

const loopingServices = [
  ...services.map((service) => ({ service, clone: false })),
  ...services.map((service) => ({ service, clone: true })),
];
---

<section class="slab" id="services" aria-labelledby="services-heading" data-services>
  <div class="section services">
    <div class="services__intro editorial-header">
      <p class="eyebrow">Our services</p>
      <h2 id="services-heading">Cleaning that fits how your <em>building works.</em></h2>
    </div>

    <div
      class="services__scroller"
      data-services-scroller
      tabindex="0"
      role="region"
      aria-label="Cleaning services"
    >
      <ul class="services__track">
        {loopingServices.map(({ service, clone }, index) => (
          <li
            class="service-card grain"
            data-service-clone={clone ? "true" : undefined}
            aria-hidden={clone ? "true" : undefined}
            inert={clone ? true : undefined}
          >
            <ResponsivePicture
              src={service.image}
              alt={service.imageAlt}
              widths={[400, 640, 960]}
              sizes="(min-width: 64rem) 22rem, 80vw"
              class="service-card__image"
            />
            <div class="service-card__body">
              <div class="service-card__top">
                <span class="service-card__index" aria-hidden="true">{String((index % services.length) + 1).padStart(2, "0")}</span>
                <h3>{service.name}</h3>
              </div>
              <div class="service-card__details">
                <p>{service.summary}</p>
                <button
                  class="service-card__action"
                  type="button"
                  data-prefill-service={service.id}
                  data-track="service_selected"
                >
                  <span aria-hidden="true">→</span>
                  Add {service.name.toLowerCase()} to quote
                </button>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="services__footer">
      <div class="services__controls">
        <button type="button" aria-label="Previous service" data-services-prev><span aria-hidden="true">←</span></button>
        <button type="button" aria-label="Next service" data-services-next><span aria-hidden="true">→</span></button>
      </div>
    </div>
  </div>
</section>

<style>
  .services {
    padding-inline: 0;
    padding-block: clamp(5rem, 8vw, 8rem);
  }

  .services__intro {
    margin-inline: var(--gutter);
  }

  .services__scroller {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-padding-inline: max(var(--gutter), calc((100vw - var(--content)) / 2 + var(--gutter)));
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .services__scroller::-webkit-scrollbar {
    display: none;
  }

  .services__track {
    list-style: none;
    display: flex;
    gap: 1rem;
    margin: 0;
    padding-inline: max(var(--gutter), calc((100vw - var(--content)) / 2 + var(--gutter)));
    transform: translate3d(0, 0, 0);
    will-change: transform;
  }

  .service-card {
    position: relative;
    flex: 0 0 min(28rem, 84vw);
    height: clamp(29rem, 46vw, 36rem);
    background: var(--navy);
    border-radius: var(--radius-card);
    overflow: hidden;
    outline: 1px solid oklch(0 0 0 / 0.1);
    outline-offset: -1px;
    box-shadow: var(--shadow-card);
    transition:
      transform 320ms var(--ease),
      box-shadow 320ms var(--ease);
  }

  .service-card__image,
  .service-card :global(picture),
  .service-card :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .service-card :global(picture) {
    display: block;
  }

  .service-card :global(img) {
    transition: transform 700ms var(--ease);
  }

  .service-card__body {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: space-between;
    padding: clamp(1.25rem, 2.2vw, 2rem);
    color: var(--white);
    background:
      linear-gradient(180deg, rgb(11 24 40 / 0.66), transparent 46%, rgb(11 24 40 / 0.78));
  }

  .service-card__details {
    display: grid;
    gap: 1rem;
  }

  .service-card__details p {
    max-width: 34rem;
    color: rgb(255 255 255 / 0.86);
    font-size: var(--step--1);
  }

  .service-card__top {
    display: grid;
    gap: 0.7rem;
  }

  .service-card__index {
    color: var(--gold-on-dark);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.16em;
  }

  h3 {
    max-width: 12ch;
    font-size: clamp(1.8rem, 2.8vw, 2.75rem);
    font-weight: var(--weight-regular);
    line-height: 1;
  }

  .service-card__action {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--white);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .service-card__action span {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid rgb(255 255 255 / 0.74);
    border-radius: 50%;
    transition: transform var(--duration) var(--ease), background-color var(--duration) var(--ease);
  }

  .service-card__action:active span {
    transform: scale(0.96);
  }

  .services__footer {
    display: flex;
    justify-content: flex-end;
    align-items: start;
    margin-inline: var(--gutter);
    padding-top: 1.75rem;
  }

  .services__controls {
    display: flex;
    gap: 0.75rem;
  }

  .services__controls button {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 0;
    border-radius: 50%;
    background: var(--ivory);
    color: var(--ink);
    cursor: pointer;
    transition: transform var(--duration) var(--ease), opacity var(--duration) var(--ease);
  }

  .services__controls button:active {
    transform: scale(0.96);
  }

  .services__controls button:disabled {
    opacity: 0.38;
    cursor: default;
  }

  @media (hover: hover) and (pointer: fine) {
    .service-card:hover {
      transform: translateY(-0.35rem);
      box-shadow: var(--shadow-lift);
    }

    .service-card:hover :global(img) {
      transform: scale(1.045);
    }

    .service-card__action:hover span {
      background: var(--white);
      color: var(--navy);
      transform: translateX(0.2rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .services__scroller {
      scroll-snap-type: x mandatory;
    }

    .service-card {
      scroll-snap-align: start;
      transition: none;
    }

    .service-card :global(img),
    .service-card__action span {
      transition-duration: 120ms;
    }

    .service-card:hover,
    .service-card:hover :global(img) {
      transform: none;
    }
  }
</style>

<script>
  import "../scripts/services.ts";
</script>
