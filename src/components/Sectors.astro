---
import ResponsivePicture from "./Picture.astro";
import { sectors } from "../data/site.ts";
---

<section class="slab" id="sectors" aria-labelledby="sectors-heading" data-sectors>
  <div class="section">
    <div class="sectors__header editorial-header">
      <p class="eyebrow">Who we work with</p>
      <div class="sectors__heading-row">
        <h2 id="sectors-heading">Cleaning shaped around how each <em>building runs.</em></h2>
        <div class="sectors__controls" aria-label="Choose a sector">
          <button type="button" aria-label="Previous sector" data-sectors-prev>
            <span aria-hidden="true">←</span>
          </button>
          <button type="button" aria-label="Next sector" data-sectors-next>
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </div>
    </div>
    <ul class="sector-grid" data-sector-grid>
      {sectors.map((sector, index) => (
        <li
          class:list={["sector-card", "grain", index === 0 && "is-active"]}
          data-sector-card
          data-sector-name={sector.name}
        >
          <ResponsivePicture
            src={sector.image}
            alt={sector.imageAlt}
            widths={[640, 960, 1400]}
            sizes="(min-width: 72rem) 50vw, 84vw"
            class="sector-card__image"
          />
          <button
            class="sector-card__selector"
            type="button"
            aria-label={`Show details for ${sector.name}`}
            aria-pressed={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? -1 : 0}
            data-sector-select
          ></button>
          <div class="sector-card__body">
            <div class="sector-card__title">
              <span class="sector-card__for">For</span>
              <h3>{sector.name}</h3>
            </div>
            <span class="sector-card__peek" aria-hidden="true">→</span>
            <div class="sector-card__details">
              <div class="sector-card__details-inner">
                <p>{sector.summary}</p>
                <button
                  class="sector-card__action"
                  type="button"
                  data-prefill-sector={sector.id}
                  data-track="sector_selected"
                >
                  <span>{sector.quoteLabel}</span>
                  <span aria-hidden="true">→</span>
                </button>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>
    <p class="visually-hidden" role="status" aria-live="polite" data-sector-status></p>
  </div>
</section>

<style>
  .section {
    padding-block: clamp(4rem, 5vw, 4.5rem);
  }

  .section .sectors__header {
    gap: clamp(2.5rem, 3vw, 3rem);
    margin-bottom: clamp(2.5rem, 3vw, 3rem);
  }

  .sectors__heading-row {
    display: grid;
    gap: 1.5rem;
  }

  .section .sectors__heading-row h2 {
    max-width: 68rem;
    font-size: clamp(2.35rem, 3.35vw, 3.5rem);
  }

  .sectors__controls {
    display: flex;
    gap: 0.75rem;
  }

  .sectors__controls button {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    padding: 0;
    border: 1px solid rgb(20 32 51 / 0.28);
    border-radius: 0.25rem;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition:
      transform var(--duration) var(--ease),
      border-color var(--duration) var(--ease),
      background-color var(--duration) var(--ease);
  }

  .sectors__controls button:active {
    transform: scale(0.96);
  }

  .sector-grid {
    list-style: none;
    display: flex;
    gap: 1rem;
    margin: 0 calc(var(--gutter) * -1);
    padding: 0 var(--gutter) 0.75rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }

  .sector-grid::-webkit-scrollbar {
    display: none;
  }

  .sector-card {
    position: relative;
    flex: 0 0 min(84vw, 28rem);
    min-width: 0;
    height: clamp(31rem, 118vw, 38rem);
    background: var(--navy);
    border-radius: var(--radius-card);
    overflow: hidden;
    scroll-snap-align: center;
    outline: 1px solid oklch(0 0 0 / 0.1);
    outline-offset: -1px;
    box-shadow: var(--shadow-card);
    transition:
      flex-grow 560ms cubic-bezier(0.77, 0, 0.175, 1),
      box-shadow 320ms var(--ease);
  }

  .sector-card__selector {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: inherit;
    background: transparent;
    cursor: pointer;
  }

  .sector-card__selector:focus-visible {
    outline: 3px solid rgb(255 255 255 / 0.85);
    outline-offset: -5px;
  }

  .sector-card.is-active .sector-card__selector {
    pointer-events: none;
  }

  .sector-card__image,
  .sector-card :global(picture),
  .sector-card :global(img) {
    width: 100%;
    position: absolute;
    inset: 0;
    height: 100%;
    object-fit: cover;
  }

  .sector-card :global(img) {
    transition: transform 260ms var(--ease);
  }

  .sector-card :global(picture) {
    display: block;
  }

  .sector-card__body {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 1.15rem;
    padding: clamp(1.5rem, 2.5vw, 2.3rem);
    color: var(--white);
    background: linear-gradient(
      180deg,
      transparent 38%,
      rgb(11 24 40 / 0.58) 68%,
      rgb(11 24 40 / 0.98) 100%
    );
  }

  h3 {
    max-width: 12ch;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.8vw, 2.45rem);
    font-weight: var(--weight-regular);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .sector-card__for {
    display: block;
    margin-bottom: 0.35rem;
    font-family: var(--font-accent);
    font-size: clamp(1.35rem, 2.2vw, 1.7rem);
    font-style: italic;
    font-weight: var(--weight-light);
    line-height: 1;
    color: var(--gold-on-dark);
  }

  .sector-card__peek {
    color: var(--gold-on-dark);
    font-size: 1.55rem;
    line-height: 1;
    transition:
      transform var(--duration) var(--ease),
      opacity 220ms var(--ease);
  }

  .sector-card__details {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transform: translateY(8px);
    transition:
      grid-template-rows 480ms cubic-bezier(0.77, 0, 0.175, 1),
      opacity 280ms var(--ease),
      transform 480ms cubic-bezier(0.77, 0, 0.175, 1);
  }

  .sector-card__details-inner {
    display: grid;
    gap: 1.25rem;
    min-height: 0;
    overflow: hidden;
  }

  .sector-card.is-active .sector-card__details {
    grid-template-rows: 1fr;
    opacity: 1;
    transform: translateY(0);
  }

  .sector-card.is-active .sector-card__peek {
    opacity: 0;
    transform: translateX(0.4rem);
    pointer-events: none;
  }

  .sector-card__details p {
    max-width: 36rem;
    color: rgb(255 255 255 / 0.9);
    font-size: var(--step-0);
    line-height: 1.55;
  }

  .sector-card__action {
    position: relative;
    z-index: 3;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    width: min(100%, 24rem);
    min-height: 3.5rem;
    padding: 0.8rem 1.2rem;
    border: 1px solid var(--glass-border-light);
    border-radius: 0.2rem;
    background: rgb(255 255 255 / 0.12);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    color: var(--white);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.09em;
    line-height: 1.2;
    text-align: start;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      transform var(--duration) var(--ease),
      background-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  .sector-card__action:active {
    transform: scale(0.96);
  }

  @media (hover: hover) and (pointer: fine) {
    .sectors__controls button:hover {
      border-color: var(--navy);
      background: var(--ivory);
    }

    .sector-card:not(.is-active):hover :global(img) {
      transform: scale(1.025);
    }

    .sector-card:not(.is-active):hover .sector-card__peek {
      transform: translateX(0.2rem);
    }

    .sector-card__action:hover {
      background: rgb(255 255 255 / 0.92);
      color: var(--navy);
    }
  }

  @media (min-width: 72rem) {
    .section {
      display: grid;
      grid-template-rows: auto minmax(0, 1fr);
      block-size: min(100svh, 62rem);
      padding-block: clamp(1.5rem, 3.5vh, 3rem);
    }

    .section .sectors__header {
      gap: clamp(2.5rem, 4vh, 2.75rem);
      margin-bottom: clamp(1.5rem, 3vh, 2rem);
    }

    .sectors__heading-row {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    .sector-grid {
      display: flex;
      gap: 1rem;
      height: auto;
      min-height: 0;
      margin: 0;
      padding: 0;
      overflow: visible;
      scroll-snap-type: none;
    }

    .sector-card {
      flex: 1 1 0;
      width: auto;
      height: 100%;
      min-height: 0;
      scroll-snap-align: none;
    }

    .sector-card.is-active {
      flex-grow: 3;
    }

    .sector-card:not(.is-active) .sector-card__body {
      padding-inline: clamp(1rem, 1.4vw, 1.4rem);
    }

    .sector-card:not(.is-active) h3 {
      max-width: 10ch;
      font-size: clamp(1.35rem, 1.8vw, 1.85rem);
    }

    .sector-card.is-active h3 {
      max-width: 18ch;
      font-size: clamp(2.15rem, 2.5vw, 2.65rem);
    }

    .sector-card h3 {
      transition: font-size 560ms cubic-bezier(0.77, 0, 0.175, 1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sector-card :global(img),
    .sector-card__peek,
    .sector-card__action,
    .sectors__controls button {
      transition-duration: 120ms;
    }

    .sector-card,
    .sector-card__details,
    .sector-card h3 {
      transition-duration: 120ms;
    }

    .sector-card__details {
      transform: none;
    }

    .sector-card:hover :global(img),
    .sector-card:hover .sector-card__peek {
      transform: none;
    }
  }

</style>

<script>
  import "../scripts/sectors.ts";
</script>
