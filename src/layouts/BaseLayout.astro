---
import "@fontsource-variable/instrument-sans";
import "@fontsource/instrument-serif/400-italic.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import { analytics, site } from "../data/site.ts";
import { isUsableGaId } from "../lib/placeholders.ts";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  preloadImage?: string;
}

const {
  title = `${site.name} — ${site.tagline}`,
  description = site.description,
  canonicalPath = "/",
  preloadImage,
} = Astro.props;

const canonical = new URL(canonicalPath, site.url).toString();
const gaReady = isUsableGaId(analytics.measurementId);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1828" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <slot />
    <Footer />
    <ConsentBanner />
    <script is:inline define:vars={{ measurementId: analytics.measurementId, gaReady }}>
      window.__FTG_ANALYTICS__ = { measurementId, enabled: gaReady };
    </script>
    <script>
      import "../scripts/consent.ts";
      import "../scripts/analytics.ts";
      import "../scripts/menu.ts";
    </script>
  </body>
</html>
